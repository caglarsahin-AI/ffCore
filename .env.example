# FFCore ortam değişkenleri. Kopyalayın: cp .env.example .env
# .env dosyasını yalnızca kurulumu yapan kişi doldurur; ajanlar ve scriptler .env yazmaz.
# Boş bırakılan gizli değerler zorunludur: compose eksik değerde açık hatayla durur.

# --- Profil ve arka uç seçimi (CONTRACTS C12) ---

# Dağıtım profili: llmaas (model sağlayıcıdan, ürün varsayılanı) ya da airgap (kapalı ağ, yerel model).
DEPLOY_PROFILE=llmaas
# Çıkarım arka ucu (airgap'te modelin çalıştığı motor): ollama ya da vllm.
INFERENCE_BACKEND=ollama
# Vektör deposu sürücüsü: pgvector (ürün varsayılanı) ya da qdrant.
VECTOR_BACKEND=pgvector
# Dış ağ kapalı mı: true ise dış ağ gerektiren her şey kapalı ya da iç aynaya yönlü.
OFFLINE=false
# Etkin compose profilleri. llmaas'ta boş; Ollama yalnızca airgap + INFERENCE_BACKEND=ollama ile açılır.
COMPOSE_PROFILES=

# --- İmajlar ve sürüm ---

# Tüm imaj adlarının öneki (iç registry), sonunda / ile. Boşsa imajlar kaynak registry'den çekilir.
REGISTRY_PREFIX=
# FFCore imaj sürümü (backend, frontend, tools). latest kullanılmaz.
FFCORE_VERSION=0.0.0

# --- Ollama (yalnızca COMPOSE_PROFILES=ollama iken) ---

# Ollama bağlam uzunluğu, zorunlu. Varsayılan 4096 prompt'u sessizce kırpar (PayCore ölçümü: 32768).
OLLAMA_CONTEXT_LENGTH=32768
# Bellekte aynı anda tutulan Ollama model sayısı: 1 (yalnızca chat); memory-extract ayrı modelse 2.
OLLAMA_MAX_LOADED_MODELS=1
# Ollama konteyner bellek sınırı; değer docs/donanim.md bellek bütçesinden ölçülerek verilir.
OLLAMA_MEM_LIMIT=
# Sunucuda modeller zaten varsa model dizininin host yolu; boşsa adlandırılmış volume kullanılır.
OLLAMA_MODELS_DIR=

# --- FFCore Postgres (pgvector) ve Redis ---

# Uygulama veritabanı kullanıcısı.
POSTGRES_USER=ffcore
# Uygulama veritabanı şifresi (gizli, zorunlu).
POSTGRES_PASSWORD=
# Uygulama veritabanı adı. LiteLLM aynı sunucuda ayrı "litellm" veritabanını kullanır.
POSTGRES_DB=ffcore
# FFCore Redis şifresi (gizli, zorunlu).
REDIS_PASSWORD=

# --- LiteLLM (yalnızca iç ağ) ---

# LiteLLM yönetici anahtarı (gizli, zorunlu; "sk-" ile başlar).
LITELLM_MASTER_KEY=
# LiteLLM'in veritabanındaki sağlayıcı anahtarlarını şifrelediği anahtar (gizli, zorunlu; sonradan değiştirilmez).
LITELLM_SALT_KEY=

# --- Langfuse v3 (yalnızca iç ağ; kendi Postgres, ClickHouse, MinIO ve Redis'i) ---

# Langfuse adresi (oturum geri dönüşleri için).
LANGFUSE_URL=http://localhost:3000
# Langfuse oturum gizli anahtarı (gizli, zorunlu).
LANGFUSE_NEXTAUTH_SECRET=
# Langfuse tuz değeri (gizli, zorunlu).
LANGFUSE_SALT=
# Langfuse şifreleme anahtarı, 64 onaltılık karakter (gizli, zorunlu; openssl rand -hex 32).
LANGFUSE_ENCRYPTION_KEY=
# Langfuse Postgres kullanıcısı.
LANGFUSE_POSTGRES_USER=langfuse
# Langfuse Postgres şifresi (gizli, zorunlu).
LANGFUSE_POSTGRES_PASSWORD=
# Langfuse Postgres veritabanı adı.
LANGFUSE_POSTGRES_DB=langfuse
# Langfuse ClickHouse kullanıcısı.
LANGFUSE_CLICKHOUSE_USER=clickhouse
# Langfuse ClickHouse şifresi (gizli, zorunlu).
LANGFUSE_CLICKHOUSE_PASSWORD=
# Langfuse MinIO (S3) kullanıcısı.
LANGFUSE_MINIO_USER=minio
# Langfuse MinIO (S3) şifresi (gizli, zorunlu; en az 8 karakter).
LANGFUSE_MINIO_PASSWORD=
# Langfuse Redis şifresi (gizli, zorunlu).
LANGFUSE_REDIS_PASSWORD=

# --- Yayınlanan portlar (yalnızca backend ve frontend) ---

# Backend host portu.
BACKEND_PORT=8000
# Frontend host portu.
FRONTEND_PORT=3000

# --- airgap örneği (kapalı ağ, Ollama CPU) ---
# DEPLOY_PROFILE=airgap
# INFERENCE_BACKEND=ollama
# OFFLINE=true
# COMPOSE_PROFILES=ollama
# REGISTRY_PREFIX=registry.ic/
# OLLAMA_MEM_LIMIT=36g
