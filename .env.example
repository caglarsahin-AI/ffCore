# FFCore environment variables. Copy: cp .env.example .env
# Only the person installing FFCore fills in .env; agents and scripts never write it.
# Secret values left empty are mandatory: compose stops with an explicit error when one is missing.

# --- Profile and backend selection (CONTRACTS C12) ---

# Deployment profile: llmaas (model from a provider, product default) or airgap (closed network, local model).
DEPLOY_PROFILE=llmaas
# Inference backend (the engine that runs the model in airgap): ollama or vllm.
INFERENCE_BACKEND=ollama
# Vector store driver: pgvector (product default) or qdrant.
VECTOR_BACKEND=pgvector
# Qdrant URL when VECTOR_BACKEND=qdrant (compose service: http://qdrant:6333, then also add
# qdrant to ALLOWED_INTERNAL_HOSTS and qdrant to COMPOSE_PROFILES). Empty for pgvector.
QDRANT_URL=
# Is the external network off? If true, everything that needs the external network is off or points to an internal mirror.
OFFLINE=false
# Active compose profiles. Empty in llmaas; Ollama starts only with airgap + INFERENCE_BACKEND=ollama.
COMPOSE_PROFILES=

# --- Images and version ---

# Prefix for all image names (internal registry), ending with /. If empty, images are pulled from their source registry.
REGISTRY_PREFIX=
# FFCore image version (backend, frontend, tools). latest is never used.
FFCORE_VERSION=0.0.0

# --- Ollama (only when deploy/docker-compose.ollama.yml is added and COMPOSE_PROFILES=ollama; may stay empty in llmaas) ---

# Ollama context length, mandatory. The default 4096 silently truncates prompts (PayCore measurement: 32768).
OLLAMA_CONTEXT_LENGTH=32768
# Number of Ollama models kept in memory at once: 1 (chat only); 2 if memory-extract is a separate model.
OLLAMA_MAX_LOADED_MODELS=1
# Ollama container memory limit; the value is measured from the memory budget in docs/donanim.md.
OLLAMA_MEM_LIMIT=
# Host path of the model directory if the models already exist on the server; if empty, a named volume is used.
OLLAMA_MODELS_DIR=

# --- FFCore Postgres (pgvector) and Redis ---

# Application database user.
POSTGRES_USER=ffcore
# Application database password (secret, mandatory).
POSTGRES_PASSWORD=
# Application database name. LiteLLM uses a separate "litellm" database on the same server.
POSTGRES_DB=ffcore
# FFCore Redis password (secret, mandatory).
REDIS_PASSWORD=

# --- Internal identity and outbound calls (03b) ---

# Internal service account token (mcp-search, workers call the backend with "Authorization: Bearer <token>").
# Secret, mandatory, at least 32 characters (for example: openssl rand -hex 32).
SERVICE_TOKEN=
# Signing key for X-On-Behalf-Of tokens (HS256, lifetime at most 5 minutes). Secret, mandatory,
# at least 32 characters; rotated independently of SERVICE_TOKEN.
OBO_JWT_SECRET=
# Hosts that outbound calls may reach, comma-separated (exact name or *.suffix). Empty means no external host.
# llmaas: provider and enabled channel/source hosts; airgap: empty (OFFLINE=true).
EGRESS_ALLOWLIST=
# Hosts or CIDRs that may resolve to private addresses, comma-separated (internal services).
# litellm is the model gateway the backend calls (package 01); add others as packages need them.
ALLOWED_INTERNAL_HOSTS=litellm

# --- Console sign-in and stored provider keys (03a) ---

# Signing key for console session cookies (HS256). Secret, mandatory, at least 32 characters;
# separate from OBO_JWT_SECRET. Changing it signs everyone out.
SECRET_KEY=
# Key that encrypts provider configurations (API keys) in the database. Secret, mandatory.
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never change it without re-encrypting: stored provider keys become unreadable.
FERNET_KEY=
# Embedding dimension of this installation (bge-m3: 1024). One embedding model per installation;
# a model whose measured dimension differs is refused.
EMBED_DIM=1024
# --- Knowledge base (04a). Defaults are measured values; change them only on purpose. ---
# The one in-process embedding model (dense + sparse) and the reranker; weights in model_cache.
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Rerank floor: candidates scoring below are not returned (and are counted in kb_queries).
RERANK_MIN_SCORE=0.1
# Per-file conversion limit in seconds; past it the worker process is killed (status timeout).
CONVERT_TIMEOUT_SECONDS=600
# Scanned PDFs: at most this many pages go through OCR (the truncation is stated).
OCR_PDF_MAX_PAGES=200
# Converter process limits: address space (MB) and CPU seconds per file; worker container memory.
CONVERT_MEMORY_LIMIT_MB=10240
CONVERT_CPU_LIMIT_SECONDS=3600
WORKER_MEM_LIMIT=6g
# One upload request (all its files), refused with 413 before the body is read.
UPLOAD_MAX_REQUEST_BYTES=541065216
# Offline in both profiles: model weights come only from `make models` (docs/bilgi-tabani.md).
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# Languages Kapı 1 accepts (comma separated).
ALLOWED_LANGUAGES=tr,en
# Name of the arq ingest queue (C10: ingest). Only test runs use another name.
ARQ_QUEUE_INGEST=ingest
# Origins the console is served from, comma-separated (scheme://host:port). Cookie-authenticated
# changes from any other origin are refused.
CONSOLE_ORIGINS=http://localhost:3000
# Session lifetime in seconds (default 28800 = 8 hours).
SESSION_TTL_S=28800

# --- Guardrails and PII (08) ---

# Scan the final packet sent to the model provider (egress stage). Mandatory, no default:
# llmaas installations set true, airgap installations set false (the model never leaves).
GUARDRAIL_EGRESS_ENABLED=true
# Lifetime in seconds of a run's tokenize mapping (<<PII_n>> placeholders) in Redis; renewed on
# every use. Keep it longer than the longest run (cpu run timeout 900 s).
PII_TOKEN_TTL_S=1800

# --- LiteLLM (internal network only) ---

# LiteLLM master key (secret, mandatory; starts with "sk-").
LITELLM_MASTER_KEY=
# Key LiteLLM uses to encrypt provider keys in its database (secret, mandatory; never changed later).
LITELLM_SALT_KEY=
# LiteLLM address on the internal network; its host must also be listed in ALLOWED_INTERNAL_HOSTS.
LITELLM_URL=http://litellm:4000
# The one key the backend sends model calls with (secret, mandatory; starts with "sk-"). The
# backend registers it in LiteLLM on start-up; no per-project keys exist (decision A4).
LITELLM_INTERNAL_KEY=
# Per-call model timeout in seconds (written to every LiteLLM model): llmaas 60,
# airgap on CPU (Ollama) 600, airgap on GPU (vLLM) 120. The run timeout is separate (agents).
LLM_CALL_TIMEOUT_S=60
# Log level of the backend, workers and CLI: DEBUG, INFO, WARNING or ERROR. Secrets are scrubbed
# from every log line; third-party HTTP loggers stay at WARNING even under DEBUG.
LOG_LEVEL=INFO

# --- First-install seed (make seed-models; read once, stored encrypted; remove afterwards) ---

# llmaas: Anthropic API key (secret).
SEED_ANTHROPIC_API_KEY=
# llmaas, optional chat-fallback: Azure OpenAI key (secret), EU resource endpoint, API version and
# deployment name. Leave all empty for no fallback.
SEED_AZURE_OPENAI_API_KEY=
SEED_AZURE_OPENAI_API_BASE=
SEED_AZURE_OPENAI_API_VERSION=2024-10-21
SEED_AZURE_OPENAI_DEPLOYMENT=
# airgap: Ollama address (PayCore: http://host.docker.internal:11434, also in ALLOWED_INTERNAL_HOSTS).
SEED_OLLAMA_BASE_URL=http://ollama:11434
# airgap with INFERENCE_BACKEND=vllm: vLLM address and its served model name.
SEED_VLLM_BASE_URL=http://vllm:8000
SEED_VLLM_MODEL=

# --- Langfuse v3 (internal network only; its own Postgres, ClickHouse, MinIO and Redis) ---

# Langfuse address (for session redirects).
LANGFUSE_URL=http://localhost:3000
# Langfuse session secret (secret, mandatory).
LANGFUSE_NEXTAUTH_SECRET=
# Langfuse salt (secret, mandatory).
LANGFUSE_SALT=
# Langfuse encryption key, 64 hexadecimal characters (secret, mandatory; openssl rand -hex 32).
LANGFUSE_ENCRYPTION_KEY=
# Langfuse Postgres user.
LANGFUSE_POSTGRES_USER=langfuse
# Langfuse Postgres password (secret, mandatory).
LANGFUSE_POSTGRES_PASSWORD=
# Langfuse Postgres database name.
LANGFUSE_POSTGRES_DB=langfuse
# Langfuse ClickHouse user.
LANGFUSE_CLICKHOUSE_USER=clickhouse
# Langfuse ClickHouse password (secret, mandatory).
LANGFUSE_CLICKHOUSE_PASSWORD=
# Langfuse MinIO (S3) user.
LANGFUSE_MINIO_USER=minio
# Langfuse MinIO (S3) password (secret, mandatory; at least 8 characters).
LANGFUSE_MINIO_PASSWORD=
# Langfuse Redis password (secret, mandatory).
LANGFUSE_REDIS_PASSWORD=

# --- Published ports (backend and frontend only) ---

# Backend host port.
BACKEND_PORT=8000
# Frontend host port.
FRONTEND_PORT=3000

# --- airgap example (closed network, Ollama on CPU) ---
# DEPLOY_PROFILE=airgap
# INFERENCE_BACKEND=ollama
# OFFLINE=true
# EGRESS_ALLOWLIST=
# The Ollama service is in a separate compose file; the separator is a comma so it is the same on every OS.
# COMPOSE_PATH_SEPARATOR=,
# COMPOSE_FILE=compose.yaml,deploy/docker-compose.ollama.yml
# COMPOSE_PROFILES=ollama
# REGISTRY_PREFIX=registry.ic/
# OLLAMA_MEM_LIMIT=36g
