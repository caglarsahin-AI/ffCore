# plan/18 scenario stack: a second --env-file after .env.test (K-SEN-0024); later files win.
# Every compose command for this stack takes both files (FOLLOWUP-93):
#   docker compose --env-file .env.test --env-file tests/e2e/scenarios/e2e.env ...
# No secrets here. Passwords come from the shell: E2E_PASSWORD, E2E_ADMIN_EMAIL,
# E2E_ADMIN_PASSWORD (tests/e2e/scenarios/README.md).

# Deterministic embedding and rerank stand-ins: the test stack has no model weights.
FAKE_EMBED=1
# .env.test's list + fake-llm: the backend checks a provider's base URL against the egress
# policy before it writes the model to LiteLLM (services/litellm_reconcile.py, check_url);
# LiteLLM is the one that connects to fake-llm. test_18_env_overlay keeps the lists in step.
ALLOWED_INTERNAL_HOSTS=litellm,langfuse-web,mcp-search,mcp-sql,ticket-desk,fake-llm
