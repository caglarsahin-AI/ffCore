"""Reviewer probes for 11-2 r1 (not part of the branch)."""

from tests.integration.runs_fixtures import *  # noqa: F403 - fixtures
from tests.integration.test_11_2_chat import _columns, _url, answered, portal, scores  # noqa: F401


def test_rv_p1_user_role_default_source_writes_the_expert_column(answered, pg, scores):
    # A `user` member's own vote without `source` (the default `review`): where does it land?
    project_id, client, run_id = answered
    response = client.post(_url(project_id, f"/runs/{run_id}/feedback"), json={"vote": "wrong"})
    expert, user = _columns(pg, run_id)
    pending = client.get(_url(project_id, "/runs"), params={"feedback": "pending"}).json()["items"]
    print("P1", response.status_code, expert, user, [s["name"] for s in scores.scores],
          "pending:", [r["id"] for r in pending])


def test_rv_p2_chat_vote_partial_and_second_vote(answered, pg, scores):
    project_id, client, run_id = answered
    a = client.post(_url(project_id, f"/runs/{run_id}/feedback"),
                    json={"vote": "partial", "source": "chat"})
    b = client.post(_url(project_id, f"/runs/{run_id}/feedback"),
                    json={"vote": "correct", "source": "chat", "note": "ok"})
    expert, user = _columns(pg, run_id)
    print("P2", a.status_code, b.status_code, expert, user)


def test_rv_p3_portal_edges(portal):
    project_id, agent_id, client = portal
    url = _url(project_id, f"/agents/{agent_id}")
    cases = {
        "welcome 500": {"welcome": "x" * 500},
        "welcome 501": {"welcome": "x" * 501},
        "example 200": {"examples": ["y" * 200]},
        "example 201": {"examples": ["y" * 201]},
        "examples 4": {"examples": ["a", "b", "c", "d"]},
        "example blank": {"examples": ["  "]},
        "example empty": {"examples": [""]},
        "welcome empty": {"welcome": ""},
        "accent upper": {"accent": "#0F766E"},
        "accent short": {"accent": "#abc"},
        "accent name": {"accent": "teal"},
        "accent alpha": {"accent": "#0f766e80"},
        "accent newline": {"accent": "#0f766e\n"},
        "extra key": {"theme": "dark"},
        "examples null": {"examples": None},
        "empty object": {},
    }
    for name, config in cases.items():
        r = client.patch(url, json={"portal_config": config})
        body = r.json()
        print("P3", name, r.status_code,
              body.get("portal_config") if r.status_code == 200 else body["error"]["code"])
    r = client.patch(url, json={"portal_config": None})
    print("P3 null", r.status_code, r.json().get("portal_config"))
    r = client.patch(url, json={"name": "only name"})
    print("P3 name-only keeps", r.status_code, r.json().get("portal_config"))

