            except OSError as ex:
                last_exc = e.OperationalError(
                    f"failed to resolve host {attempt.get('host')!r}: {ex}"
                )
                logger.debug("%s", last_exc)
    
        if not attempts:
            assert last_exc
            # We couldn't resolve anything
